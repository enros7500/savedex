# Copy to .env; personal paths/data stay outside version control.
HOST=127.0.0.1
PORT=3210
SAVEDEX_TIMEZONE=Europe/Madrid
SAVEDEX_DATABASE=./data/savedex.sqlite
# Use the installed .exe directly, never the friendly .cmd URL launcher.
# Windows 10+: Savedex's fixed supervisor contains the CLI in an owned Job Object.
SAVEDEX_EXTRACTOR_EXE=../savedex-extractor/work/asr-venv/Scripts/savedex-extractor.exe
SAVEDEX_EXTRACTOR_MODEL_DIR=../savedex-extractor/work/models/faster-whisper-medium
SAVEDEX_EXTRACTOR_WORK_DIR=./data/extractor-work
SAVEDEX_EXTRACTOR_TIMEOUT_SECONDS=900
SAVEDEX_EXTRACTOR_EXIT_GRACE_SECONDS=20

# Contextual extractor: explicit server-side opt-in (disabled by default).
SAVEDEX_EXTERNAL_INFERENCE=disabled
# For openai, configure OPENAI_API_KEY and OPENAI_VISION_MODEL in the extractor environment.
